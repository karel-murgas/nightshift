# An Obsidian Bases view of the board: a Kanban of the lanes plus two tables.
# Nothing reads it but Obsidian — the board's state is the directory a card is in,
# never this file.
#
# THESE COMMENTS DO NOT SURVIVE. Bases rewrites this file whenever the vault opens
# and its normalisation drops YAML comments, so everything below is gone from your
# copy after the first launch. That is expected, it is not damage, and the diff it
# produces should just be committed. Nothing here is load-bearing for that reason —
# the durable copy of all of it is Board/README.md, which Obsidian does not touch.
#
# `type: kanban` needs the **Base Board** community plugin; the tables need
# **Bases**, which is core. With only Bases you get `Unknown view type: kanban`.
#
# The `oversize` formula is the board's copy of the runner's comfort threshold: a
# card in `{{board}}/tasks` bigger than CARD_COMFORT_BYTES shows its size, everything
# else shows nothing. It is computed on every render from `file.size`, so nothing is
# written into any card and compacting one by hand clears the mark immediately.
# The `14336` and the `tasks` below cannot import anything across the Bases boundary,
# so `nightshift/gates/board_view_sync.py` pins both against `runner.py` — and this
# comment is not where that is written down, because it does not survive (see above).
#
# `{{board}}/ideas` is the maintainer's private lane and is filtered out, EXCEPT for a
# note that has a `state:` — flagging one is how a note asks to leave the lane, and
# seeing that on the board is the whole point of the flag.
filters:
  and:
    - file.inFolder("{{board}}")
    - file.name != "README"
    - or:
        - '!file.inFolder("{{board}}/{{private_lane}}")'
        - "!state.isEmpty()"
formulas:
  oversize: 'if(file.inFolder("{{board}}/tasks") && file.size > 14336, (file.size / 1024).toFixed(1) + " KB", "")'
properties:
  note.state:
    displayName: Lane
  note.title:
    displayName: Title
  note.tier:
    displayName: Tier
  note.worker:
    displayName: Worker
  note.unattended:
    displayName: Unattended
  note.requires:
    displayName: Requires
  note.tags:
    displayName: Tags
  note.created:
    displayName: Created
  note.attempts:
    displayName: Attempts
  formula.oversize:
    displayName: Too big
views:
  - type: kanban
    name: Kanban
    groupBy:
      property: state
      direction: ASC
    order:
      - unattended
      - requires
      - tags
      - attempts
      - formula.oversize
    boardColumns:
{{board_columns}}
    cardTitleProperty: title
  - type: table
    name: Live
    filters:
      and:
        - '!file.inFolder("{{board}}/done")'
        - '!file.inFolder("{{board}}/failed")'
    groupBy:
      property: state
      direction: ASC
    order:
      - file.name
      - title
      - state
      - unattended
      - tags
      - worker
      - tier
      - created
      - formula.oversize
    sort:
      - property: state
        direction: DESC
    columnSize:
      note.worker: 126
      note.tier: 93
  - type: table
    name: Archive
    filters:
      or:
        - file.inFolder("{{board}}/done")
        - file.inFolder("{{board}}/failed")
    order:
      - file.name
      - title
      - state
      - created
